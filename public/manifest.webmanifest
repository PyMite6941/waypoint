{
  "id": "./",
  "name": "Waypoint",
  "short_name": "Waypoint",
  "description": "Slides you can present in order or steer: jump to any slide mid-talk, then step back to where you were.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#1c1b19",
  "theme_color": "#1c1b19",
  "categories": ["productivity", "education", "business"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"],
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow": [".ppsx"],
        "application/vnd.ms-powerpoint": [".ppt", ".pps"],
        "application/vnd.apple.keynote": [".key"],
        "application/vnd.oasis.opendocument.presentation": [".odp"]
      }
    }
  ],
  "shortcuts": [
    { "name": "Guide", "short_name": "Guide", "description": "How to use Waypoint", "url": "./docs/", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
