# Waypoint reads API keys from a file named .env (copy this file to .env).
# Running from source (npm run dev, npm run desktop) uses the .env in this folder;
# the installed desktop app uses the .env in its settings folder (AI settings, Show file).
# You can also add and remove keys in AI settings instead of editing this file.
#
# More than one key for a provider: add a label after the name. Waypoint counts each key's
# use and, set to Automatic, uses the least used one, moving on when one is rate limited,
# out of credit or over the monthly limit you set.

ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_WORK=
OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# CUSTOM_API_KEY=
